# dependencies
node_modules/

# build output
dist/
src-tauri/target/
src-tauri/gen/

# installers made by the release scripts (scripts/windows/release.bat)
releases/

# downloaded model files & local data (never commit these — they are large)
models/
*.gguf

# llama.cpp binaries pulled in during setup (the folder itself stays,
# so a fresh checkout can still compile: tauri.conf.json bundles it)
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# env
.env
.env.*
*.env

# local index and chat history (they belong in app data, not the repo)
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm

# private keys
*.pem
*.key
*.p12
*.pfx

# documents from a real folder. sample-docs/ is the only fixture set.
*.doc
*.docx
*.xls
*.xlsx
*.xlsm
*.ppt
*.pptx
*.csv
*.pdf
!sample-docs/**/*.pdf
